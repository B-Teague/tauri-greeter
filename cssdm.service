[Unit]
Description=CSSDM Display Manager
After=systemd-user-sessions.service
Conflicts=getty@tty1.service

[Service]
Type=simple
User=root
Environment="XDG_SEAT=seat0"
Environment="XDG_VTNR=1"
Environment="XDG_SESSION_CLASS=greeter"
ExecStart=/usr/local/bin/cssdm
StandardInput=tty
StandardOutput=journal
StandardError=journal
TTYPath=/dev/tty1
KillMode=none
Restart=always
RestartSec=3s
TimeoutStopSec=30

# Keep session running after DM exits (session will replace this process)
KillMode=none

[Install]
WantedBy=graphical.target
Alias=display-manager.service
