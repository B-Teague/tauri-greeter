# Maintainer: Brian Teague <br.teague@gmail.com>

# Binary package: it installs an already-built tauri-greeter, it does not compile one.
# Build the binary first (`make release` in the repo root, or `make package`
# which does both), then run makepkg here.

pkgname=tauri-greeter
pkgver=0.1.0
pkgrel=1
pkgdesc="CSS-themeable LightDM greeter, built with Tauri and Leptos"
# A prebuilt ELF is packaged as-is, so this really is x86_64 only.
arch=('x86_64')
url="https://github.com/B-Teague/tauri-greeter"
license=('GPL-3.0-or-later')
# LightDM starts the X server, authenticates and launches the session; this
# package is only the greeter it draws with. liblightdm-gobject-1 ships in the
# lightdm package and is linked at runtime.
depends=('lightdm' 'webkit2gtk-4.1' 'gtk3' 'glib2')
install="$pkgname.install"
# Nothing is compiled here, and the binary is already stripped by the release
# profile — leave it alone rather than have makepkg hunt for debug symbols.
options=('!strip' '!debug')

# Files come from the checkout this PKGBUILD lives in. To publish a -bin
# package on the AUR, drop _repo and use a release artifact instead:
#   source=("$url/releases/download/v$pkgver/tauri-greeter-$pkgver-x86_64.tar.gz")
# with its sha256sum, then cd into "$srcdir" in package().
source=()
sha256sums=()
_repo="$startdir/../.."

package() {
  cd "$_repo"

  if [[ ! -f target/release/tauri-greeter ]]; then
    echo "==> ERROR: target/release/tauri-greeter not found. Run 'make release' first." >&2
    return 1
  fi

  install -Dm755 target/release/tauri-greeter "$pkgdir/usr/bin/tauri-greeter"

  # The entry in the tree points at /usr/local/bin, which is where `make install`
  # puts things; a package owns /usr/bin instead.
  sed 's|/usr/local/bin/tauri-greeter|/usr/bin/tauri-greeter|' packaging/tauri-greeter.desktop |
    install -Dm644 /dev/stdin "$pkgdir/usr/share/xgreeters/tauri-greeter.desktop"

  install -Dm644 -t "$pkgdir/usr/share/tauri-greeter/themes" themes/*.css
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE THIRD-PARTY-LICENSES.md
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" \
    README.md CHANGELOG.md SECURITY.md INSTALL.md
}
