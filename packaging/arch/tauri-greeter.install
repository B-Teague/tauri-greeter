post_install() {
	cat <<-'EOF'

	  tauri-greeter is installed, but LightDM is still drawing its current
	  greeter. Switching is left to you: a greeter that fails to come up leaves
	  you with no way in.

	  Try it first without touching your seat — this runs a whole LightDM in a
	  nested X server, as your own user:

	      lightdm --test-mode --debug

	  with greeter-session=tauri-greeter set (see below). Needs xorg-server-xephyr.

	  Once that works:

	      printf '[Seat:*]\ngreeter-session=tauri-greeter\n' |
	          sudo install -Dm644 /dev/stdin /etc/lightdm/lightdm.conf.d/50-tauri-greeter.conf
	      systemctl enable lightdm    # if some other display manager is enabled,
	                                  # disable that one first

	  Optional theme:

	      install -Dm644 /usr/share/tauri-greeter/themes/midnight.css /etc/tauri-greeter/theme.css

	EOF
}

post_upgrade() {
	if grep -rqs '^greeter-session=tauri-greeter' /etc/lightdm/; then
		echo "  tauri-greeter: the new binary is used at the next greeter start."
		echo "         Restarting lightdm now would end the session you are sitting in."
	fi
}

pre_remove() {
	# Leaving greeter-session pointed at a greeter that is about to disappear
	# means LightDM falls back to its default — recoverable, but say so rather
	# than let it be a surprise at the next boot.
	if grep -rqs '^greeter-session=tauri-greeter' /etc/lightdm/; then
		echo "  tauri-greeter: still selected in /etc/lightdm. Remove that setting, or"
		echo "         LightDM will fall back to its default greeter at the next start."
	fi
}
