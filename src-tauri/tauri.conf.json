{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cssdm",
  "version": "0.1.0",
  "identifier": "com.brian.cssdm",
  "build": {
    "devUrl": "file://../index.html",
    "frontendDist": ".."
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "cssdm",
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
