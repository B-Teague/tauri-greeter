# Maintainer: Brian Teague <br.teague@gmail.com>

# Binary package: it installs an already-built cssdm, it does not compile one.
# Build the binary first (`make release` in the repo root, or `make package`
# which does both), then run makepkg here.

pkgname=cssdm
pkgver=0.1.0
pkgrel=4
pkgdesc="CSS-themeable Linux display manager, with a Tauri/Leptos greeter"
# A prebuilt ELF is packaged as-is, so this really is x86_64 only.
arch=('x86_64')
url="https://github.com/B-Teague/CSSDM"
license=('GPL-3.0-or-later')
# The daemon runs an X server on the VT to show the greeter on; everything else
# here is linked into the binary.
depends=('xorg-server' 'webkit2gtk-4.1' 'gtk3' 'pam' 'systemd-libs')
install="$pkgname.install"
# Nothing is compiled here, and the binary is already stripped by the release
# profile — leave it alone rather than have makepkg hunt for debug symbols.
options=('!strip' '!debug')

# Files come from the checkout this PKGBUILD lives in. To publish a -bin
# package on the AUR, drop _repo and use a release artifact instead:
#   source=("$url/releases/download/v$pkgver/cssdm-$pkgver-x86_64.tar.gz")
# with its sha256sum, then cd into "$srcdir" in package().
source=()
sha256sums=()
_repo="$startdir/../.."

package() {
  cd "$_repo"

  if [[ ! -f target/release/cssdm ]]; then
    echo "==> ERROR: target/release/cssdm not found. Run 'make release' first." >&2
    return 1
  fi

  install -Dm755 target/release/cssdm "$pkgdir/usr/bin/cssdm"

  # The unit in the tree points at /usr/local/bin, which is where `make install`
  # puts things; a package owns /usr/bin instead.
  sed 's|/usr/local/bin/cssdm|/usr/bin/cssdm|' cssdm.service |
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/system/cssdm.service"

  install -Dm644 -t "$pkgdir/usr/share/cssdm/themes" themes/*.css
  install -Dm644 -t "$pkgdir/usr/share/licenses/$pkgname" \
    LICENSE THIRD-PARTY-LICENSES.md
  install -Dm644 -t "$pkgdir/usr/share/doc/$pkgname" \
    README.md SECURITY.md INSTALL.md LOCAL_TESTING.md
}
